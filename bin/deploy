#!/usr/bin/env bash
# Publishes the committed site to adapto.kz and checks the live pages.
#   bin/deploy
# How it works: push to github.com/AltynCore/adapto-site, then the Plesk Git webhook makes the
# server pull main and check it out into httpdocs. Plesk only writes the repository's files:
# what else lives in httpdocs (SakenGPT_bot) stays. The webhook address (with its uuid) is in the
# macOS keychain, item adapto-site-deploy-hook; it is in Plesk: adapto.kz → Git → repository settings.
#   SITE=https://adapto.kz/_deploy_test bin/deploy    checks another deploy folder
set -euo pipefail
cd "$(dirname "$0")/.."
SITE=${SITE:-https://adapto.kz}

[ -z "$(git status --porcelain)" ] || { echo "Uncommitted changes: commit first, the deploy sends HEAD." >&2; exit 1; }
hook=$(security find-generic-password -s adapto-site-deploy-hook -a adapto.kz -w 2>/dev/null) || {
  echo "No Plesk webhook in the keychain. Copy it from Plesk (adapto.kz → Git → repository settings) and save:" >&2
  echo "  security add-generic-password -U -s adapto-site-deploy-hook -a adapto.kz -w '<webhook url>'" >&2
  exit 1
}

git push -q origin HEAD:main
curl -fsS -o /dev/null -X POST "$hook"
echo "Pushed $(git rev-parse --short HEAD), Plesk is deploying"

# Done when every page and text file on the site is byte for byte the committed one.
url_of() { case "$1" in index.html) echo /;; kk/index.html) echo /kk/;; *.html) echo "/${1%.html}";; *) echo "/$1";; esac; }
mismatched() {
  local file
  for file in $(git ls-files '*.html' 'kk/*.html' install.sh assets/site.css); do
    [ "$(curl -s "$SITE$(url_of "$file")?v=$RANDOM" | shasum -a 256 | cut -d' ' -f1)" = "$(git show "HEAD:$file" | shasum -a 256 | cut -d' ' -f1)" ] \
      || echo "$file"
  done
}
for _ in $(seq 1 30); do
  left=$(mismatched)
  [ -z "$left" ] && break
  sleep 2
done

failed=0
[ -z "$left" ] || { echo "  not the committed version on the site: $(echo $left)" >&2; failed=1; }
for path in /assets/inter.woff2 /assets/overview.png /assets/logo.svg /download/site/latest; do
  code=$(curl -s -o /dev/null -w '%{http_code}' "$SITE$path")
  case "$code" in 200|302) ;; *) echo "  $path -> $code" >&2; failed=1;; esac
done
for hidden in /README.md /bin/deploy /zettel/; do
  code=$(curl -s -o /dev/null -w '%{http_code}' "$SITE$hidden")
  [ "$code" = 404 ] || { echo "  $hidden -> $code, must be 404" >&2; failed=1; }
done
[ "$failed" = 0 ] && echo "Live check passed: $SITE serves $(git rev-parse --short HEAD)" || { echo "Live check failed" >&2; exit 1; }
